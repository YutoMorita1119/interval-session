{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "musical-comms-app",
    "public": ".",
    "headers": [
      {
        "source": "**/*.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.css",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "artifacts/**",
      "docs/**",
      "package.json"
    ]
  }
}
